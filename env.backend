DATABASE_URL="postgresql://username:password@192.168.0.0:5432/clinux_database?schema=public"
GOOGLE_TTS_KEY=""
LOGS_DATABASE_URL="postgresql://totem:password@postgres_infra:5432/totem?schema=public"
TOKENAPIINT= ""
ADMIN_SECRET= ""
IP_PAINEL= ""
IDFUNCIONARIO= ""
IDEMPRESA= ""
IDMEDICO= ""
IDSALA= ""
IDMODALIDADE=""
FRONTEND_ORIGINS="http://localhost:3000"
# Licenciamento do backend (configuracao privada de implantacao)
LICENSE_SERVER_URL='https://{LINK_LICENCIAMENTO}'
LICENSE_PUBLIC_KEY_JWK='{"crv":{KEY}}'
LICENSE_KEY_ID='totem-licencas-ID'
LICENSE_ISSUER='urn:totem:licencas'

# QR Code do totem. Formato novo: paciente-atendimento (ex.: 123-456789).
# true  = aceita também o QR antigo, só com o código do paciente (transição)
# false = recusa o QR antigo; use quando não houver mais QRs antigos em circulação
QR_LEGADO=true

# Diagnóstico: true imprime no log o SQL e o tempo das consultas em pacientes (sem os valores). Deixe false no dia a dia.
PRISMA_LOG_QUERIES=false
